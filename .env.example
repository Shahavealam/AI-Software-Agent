# ── LLM ─────────────────────────────────────────────────────────────────
# Empty => offline mode (deterministic fallbacks, no network calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Context / summarisation ───────────────────────────────────────────
MAX_CONTEXT_TOKENS=128000
SUMMARY_TRIGGER_RATIO=0.75

# ── Self-correction loop ──────────────────────────────────────────────
MAX_SELF_CORRECTION_RETRIES=3
SANDBOX_TIMEOUT_S=30
SANDBOX_MAX_BYTES=64000

# ── Memory backends ───────────────────────────────────────────────────
# chroma | memory (in-process fallback, no server needed)
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=.agent_chroma
ENTITY_STORE_PATH=.agent_state/entities.json

# ── Conversation history (sessions + messages) ──────────────────────────
# Empty => file-backed fallback at HISTORY_STORE_PATH (offline/CI safe).
# Set to e.g. mongodb://localhost:27017 to persist in MongoDB.
MONGODB_URI=
MONGODB_DB=ai_agent
MONGODB_SESSIONS_COLLECTION=sessions
MONGODB_MESSAGES_COLLECTION=messages
HISTORY_STORE_PATH=.agent_state/history.json
HISTORY_MAX_MESSAGES=200
# ── History content volume (MongoDB docs cap at 16MB; LLM context stays ──
# ── capped separately via MAX_CONTEXT_TOKENS) ─────────────────────────
HISTORY_MESSAGE_MAX_CHARS=65536
HISTORY_SUMMARY_MAX_CHARS=20000
HISTORY_STREAM_PREVIEW_MAX_CHARS=12000
HISTORY_REPORT_FIELD_MAX_CHARS=4000
HISTORY_SAVE_AGENT_TURNS=true
HISTORY_AGENT_TURN_MAX_CHARS=12000
HISTORY_ARTIFACT_FILE_MAX_CHARS=20000
HISTORY_ARTIFACTS_TOTAL_MAX_CHARS=200000

# ── Runtime ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PROJECT_ROOT=.
